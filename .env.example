# ─────────────────────────────────────────────────────────
# The Compound Wellness — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────

# ── STRIPE ───────────────────────────────────────────────
# Get these from dashboard.stripe.com > Developers > API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Get this from Stripe > Developers > Webhooks (after adding endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── AIRTABLE ─────────────────────────────────────────────
# Get API key from airtable.com/account (Personal Access Token)
# Get Base ID from airtable.com — open your base, click Help > API docs
# The base ID is the string starting with "app..."
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...

# ── KLAVIYO ──────────────────────────────────────────────
# Get from klaviyo.com > Account > Settings > API Keys
KLAVIYO_API_KEY=pk_...
# List IDs found in Klaviyo > Lists — click a list, copy ID from URL
# Optional: if unset, contacts are upserted as profiles but not added to any list.
KLAVIYO_LIST_ID=XXXXXX           # main marketing list (all contacts)
KLAVIYO_BOOKINGS_LIST_ID=XXXXXX  # paid bookings segment
KLAVIYO_INQUIRIES_LIST_ID=XXXXXX # inquiry leads segment

# ── GOOGLE (Gmail send, Calendar invites, GA4 analytics) ─
# Create an OAuth2 Client ID (Web application) in console.cloud.google.com
# under APIs & Services > Credentials.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx
# Obtained by completing the OAuth consent flow once for adrienne@compoundoc.com
# with gmail.send + calendar + analytics.readonly scopes. NOTE: if the OAuth
# consent screen is left in "Testing" mode in Google Cloud Console, this token
# expires after 7 days and every Gmail/Calendar/GA4 call below will silently
# fail — publish the consent screen to Production to avoid that.
GOOGLE_REFRESH_TOKEN=xxxxxxxxxxxx
# From Google Analytics > Admin > Property Settings — the numeric Property ID.
GOOGLE_GA4_PROPERTY_ID=xxxxxxxxx

# ── CLERK (member portal auth — /api/portal/* routes) ────
# Get from dashboard.clerk.com > your app > API Keys.
# server.js requires CLERK_SECRET_KEY for requireAuth()/clerkClient to work
# at all — without it every /api/portal/* request will fail.
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# ── ADMIN DASHBOARD (admin.html) ─────────────────────────
# Password for the /admin.html login. Use a strong, unique value —
# it is not the "Compound2025!" default from earlier commit history.
ADMIN_PASSWORD=

# ── SLACK (optional inquiry / RSVP alerts) ───────────────
# Slack app > Incoming Webhooks > Add New Webhook to Workspace (pick the channel).
# Treat this URL as a secret. Alerts contain name, practitioner and timing only —
# never notes, phone or email.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── SECURITY ─────────────────────────────────────────────
# Content-Security-Policy starts in Report-Only mode (logs violations to the
# browser console without blocking anything). Set to 1 only after a full
# manual pass of every page shows no console CSP violations.
CSP_ENFORCE=0

# ── SERVER ───────────────────────────────────────────────
PORT=3000

# Meta (Facebook/Instagram) ads. Tracking stays OFF unless META_PIXEL_APPROVED=1.
# Do not set it until your attorney has approved it. Medical requests are never sent to Meta either way.
META_PIXEL_APPROVED=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
